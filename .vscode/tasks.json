{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "&&",
                "cmake",
                "--build",
                "${workspaceFolder}/build",
                "&&",
                "cmake",
                "--install",
                "${workspaceFolder}/build",
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Configure and build the project using CMake"
        }
    ]
}