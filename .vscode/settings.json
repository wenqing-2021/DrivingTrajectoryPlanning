{
    "terminal.integrated.defaultProfile.linux": "bash",
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "cmake.configureOnOpen": false,
    "cmake.buildDirectory": "${workspaceFolder}/build/cmake",
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/cmake/compile_commands.json",
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.path": "/usr/bin/clangd",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build/cmake",
        "--background-index",
        "--header-insertion=never"
    ],
    "[cpp]": {
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file"
    },
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true
    },
    "cmake.cpackPath": "${workspaceFolder}/.venv/bin/cpack",
    "cmake.cmakePath": "${workspaceFolder}/.venv/bin/cmake",
    "cmake.ctestPath": "${workspaceFolder}/.venv/bin/ctest",
    "cmake.configureSettings": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
    }
}
