{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Main",
            "type": "debugpy",
            "request": "launch",
            "program": "build/install/main.py",
            "console": "integratedTerminal",
            "args": [
                // "--debug",
                "--params",
                "src/config/solver_params.yaml",
                "--file",
                "data/BenchmarkCases/Case1.csv",
            ],
        },
        {
            "name": "C++ Debugger: Main",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/DEBUG_SOLVER", // Update this path
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
        }
    ]
}