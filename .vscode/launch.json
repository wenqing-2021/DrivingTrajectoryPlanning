{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Main",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/build/install/src",
            "program": "main.py",
            "console": "integratedTerminal",
            "args": [
                "--debug",
                "--params",
                "config/solver_params.yaml",
                "--file",
                "${workspaceFolder}/data/BenchmarkCases/Case1.csv",
            ],
        },
        {
            "name": "Python Debugger: Current",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "--install"
            ],
        },
        {
            "name": "C++ Debugger: Main",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/DEBUG_SOLVER", // Update this path
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/src",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
        },
        {
            "name": "C++: Test_CollisionCheck",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/src/test/collision_check/TestCollisionCheck", // Update this path
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
        },
        {
            "name": "C++: OBCA Planner Test",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/src/test/obca/test_obca_main",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build",
        }
    ]
}